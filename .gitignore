# Keep only the CubeMX / Keil project and its build dependencies.
/*
!/.gitignore
!/README.md
!/CAN协议使用说明.txt
!/FOC_v1.ioc
!/.mxproject
!/Core/
!/Drivers/
!/Middlewares/
!/MDK-ARM/

# Keil project, startup code, runtime and debugger configuration.
/MDK-ARM/*
!/MDK-ARM/FOC_v1.uvprojx
!/MDK-ARM/FOC_v1.sct
!/MDK-ARM/FOC_v1.uvoptx
!/MDK-ARM/startup_stm32g431xx.s
!/MDK-ARM/RTE/
!/MDK-ARM/DebugConfig/

# Build outputs and intermediate files. Keep vendor .lib and .a libraries.
*.o
*.obj
*.crf
*.d
*.dep
*.lst
*.LST
*.i
*.ii
*.__i
*.map
*.htm
*.axf
*.elf
*.out

# .hex and .bin are allowed inside retained directories, except build folders.
build/
bin/
obj/
out/
cmake-build-*/

# Local IDE state, logs and backups.
.vscode/
.idea/
.settings/
.eide/
.specstory/
*.uvguix
*.uvguix.*
*.uvprojx_bak
*.uvoptx_bak
*.scvd
*.JLinkLog.txt
*.jlink
JLinkLog.txt
JLinkSettings.ini
*.log
*.bak
*.orig
*.base@*
*.tmp
*~

# Documentation and tests are kept locally, including vendor copies.
docs/
tests/
*.docx

# OS and Python cache files.
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*
.directory
__pycache__/
*.pyc
